{
  "name": "dsh-desktop-clock",
  "version": "1.0.0",
  "description": "A polished floating desktop clock for the DeepSeek Harness Web GUI, with analog and digital faces, a focus timer, four themes, and persistent placement.",
  "type": "module",
  "license": "MIT",
  "author": "skyline66",
  "homepage": "https://github.com/skyline66/dsh-desktop-clock#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyline66/dsh-desktop-clock.git"
  },
  "bugs": {
    "url": "https://github.com/skyline66/dsh-desktop-clock/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-clock",
    "clock",
    "focus-timer"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "assets/*.png",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test tests/*.test.js",
    "check": "npm run build && npm test && node scripts/check-plugin.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
